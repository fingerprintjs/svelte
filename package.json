{
  "name": "@fingerprint/svelte",
  "version": "3.0.0",
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d",
  "description": "Fingerprint Svelte SDK",
  "author": "Fingerprint, Inc (https://fingerprint.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fingerprintjs/svelte.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "private": false,
  "keywords": [
    "fraud",
    "fraud detection",
    "fraud prevention",
    "browser",
    "identification",
    "fingerprint",
    "fingerprinting",
    "browser fingerprint",
    "device fingerprint",
    "privacy"
  ],
  "scripts": {
    "prepare": "husky && pnpm sync-pkg-version",
    "build": "pnpm package",
    "package": "svelte-package",
    "package:watch": "svelte-package --watch",
    "check": "svelte-check --tsconfig tsconfig.json",
    "check:watch": "svelte-check --tsconfig tsconfig.json --watch",
    "check:examples": "bash scripts/check-examples.sh",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:diff": "vitest run --coverage --reporter json --outputFile.json=report.json",
    "test:dts": "tsc --noEmit --isolatedModules --ignoreConfig dist/index.d.ts && pnpm check:examples",
    "test:svelte5": "pnpm --filter svelte5-tests test",
    "test:smoke": "bash __tests__/smoke/smoke-test.sh",
    "generate-version": "node scripts/syncVersion.js",
    "prebuild": "pnpm generate-version",
    "pretest": "pnpm generate-version",
    "precheck": "pnpm generate-version",
    "predocs": "pnpm generate-version",
    "sync-pkg-version": "node scripts/syncVersion.js && pnpm format",
    "build-all": "pnpm package && pnpm -r build",
    "docs": "pnpm package && typedoc dist/index.d.ts --options typedoc.cjs --out generated-docs",
    "changeset:version": "changeset version && pnpm sync-pkg-version",
    "changeset:publish": "HUSKY=0 changeset publish"
  },
  "dependencies": {
    "@fingerprint/agent": "^4.1.3"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@fingerprintjs/commit-lint-dx-team": "^0.1.0",
    "@fingerprintjs/eslint-config-dx-team": "^3.0.0",
    "@fingerprintjs/prettier-config-dx-team": "^0.3.0",
    "@fingerprintjs/tsconfig-dx-team": "^0.0.2",
    "@sveltejs/adapter-auto": "^3.1.1",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.22.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^4.2.20",
    "svelte-check": "^4.7.3",
    "svelte2tsx": "^0.7.58",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.ts": "pnpm run lint:fix",
    "*.svelte": "pnpm run lint:fix"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "typesVersions": {
    ">4.0": {
      "index.d.ts": [
        "./dist/index.d.ts"
      ]
    }
  }
}
